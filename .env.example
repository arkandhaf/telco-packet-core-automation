# Live UI is blocked until device pre-checks and snapshot rollback are implemented.
RELPOOL_ENABLE_LIVE=false

# Set actual testbed values locally; there are no implicit host/user defaults.
GGSN_TESTBED_HOST=
GGSN_TESTBED_PORT=22
GGSN_TESTBED_USER=
GGSN_TESTBED_PASS=

# Fernet.generate_key().decode("ascii"); never commit a real key.
SECRET_KEY=
# Optional verified known_hosts file, populated out of band.
GGSN_KNOWN_HOSTS=
# Defaults to Huawei <name> / [name] prompt matching.
# GGSN_PROMPT_REGEX=
# Plaintext passwords require explicit opt-in; keep disabled normally.
RELPOOL_ALLOW_PLAINTEXT_PASSWORD=false