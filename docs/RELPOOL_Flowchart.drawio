        <mxCell id="s3_mml" value="&lt;b&gt;Provisioning MML Builder&lt;/b&gt;&lt;br&gt;(Huawei Service-V CLI &amp; PCRF UPCC)&lt;hr size=&quot;1&quot;&gt;1. Host (h_&amp;lt;domain&amp;gt; seq 65535)&lt;br&gt;2. Filter (f_&amp;lt;domain&amp;gt; l34 any)&lt;br&gt;3. Filter-Group (fg_gaspol_&amp;lt;app&amp;gt;)&lt;br&gt;4. Charging (cbb-id, cp, catg)&lt;br&gt;5. Rule (r_&amp;lt;app&amp;gt;_&amp;lt;rg&amp;gt;_&amp;lt;sid&amp;gt;)&lt;br&gt;6. User-Profile (crbn_&amp;lt;apn&amp;gt;_sy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4338CA;fontColor=#1E1B4B;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="stage3_container">
          <mxGeometry x="15" y="50" width="220" height="185" as="geometry" />
