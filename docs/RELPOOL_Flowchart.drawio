        <mxCell id="s1_or" value="ATAU" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;fontColor=#1D4ED8;fontStyle=1;fontSize=10;" vertex="1" parent="stage1_container">
          <mxGeometry x="75" y="165" width="60" height="35" as="geometry" />
