        <mxCell id="s5_audit" value="&lt;b&gt;Tahap 5: Persistent Audit Trail&lt;/b&gt;&lt;br&gt;Tersimpan otomatis di &lt;i&gt;audit_history.json&lt;/i&gt;&lt;br&gt;(WO ID, Timestamp, APN, Status, &amp;&lt;br&gt;Payload Inspector dengan sensor kunci)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=10;" vertex="1" parent="stage4_container">
