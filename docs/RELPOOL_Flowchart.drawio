        </mxCell>
        <mxCell id="s1_manual" value="&lt;b&gt;Opsi A: Mode Manual&lt;/b&gt;&lt;br&gt;• Form Input Parameter&lt;br&gt;• Quick Preset Demo&lt;br&gt;(TikTok / Gojek / Gaming)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=11;" vertex="1" parent="stage1_container">
          <mxGeometry x="15" y="55" width="180" height="90" as="geometry" />
