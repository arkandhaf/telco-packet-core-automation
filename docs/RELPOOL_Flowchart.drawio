        <mxCell id="s4_download" value="&lt;b&gt;Download Paket Output&lt;/b&gt;&lt;br&gt;• Satuan: Script .TXT &amp; Rollback .TXT&lt;br&gt;• Batch: Arsip .ZIP (scripts/, rollbacks/,&lt;br&gt;ALL_MML_SCRIPTS.txt, MANIFEST.csv)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#14532D;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="stage4_container">
          <mxGeometry x="18" y="50" width="240" height="95" as="geometry" />
        </mxCell>
        <mxCell id="s4_ssh" value="&lt;b&gt;SSH Testbed Gateway&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Simulation Mode&lt;/b&gt; (Dry-Run Aman)&lt;br&gt;• &lt;b&gt;Live GGSN Testbed&lt;/b&gt; (Paramiko SSH&lt;br&gt;dengan Channel Buffer Draining)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0C4A6E;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="stage4_container">
          <mxGeometry x="18" y="165" width="240" height="90" as="geometry" />
