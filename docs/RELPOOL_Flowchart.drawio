        <mxCell id="s3_rollback" value="&lt;b&gt;Safe Rollback CLI Builder&lt;/b&gt;&lt;br&gt;Otomatis menyusun perintah &lt;b&gt;undo&lt;/b&gt;&lt;br&gt;dengan urutan ketergantungan terbalik&lt;br&gt;(Lepas binding → hapus rule → hapus group)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#DB2777;fontColor=#831843;fontSize=11;" vertex="1" parent="stage3_container">
