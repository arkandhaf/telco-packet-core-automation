        </mxCell>
        <mxCell id="s2_clean" value="&lt;b&gt;Input Sanitization Layer&lt;/b&gt;&lt;br&gt;• Hapus prefix http:// &amp; https://&lt;br&gt;• Hapus trailing slash (/) &amp; spasi&lt;br&gt;• APN &amp; App otomatis lowercase_underscore&lt;br&gt;• Perbaikan angka Excel (11010.0 → 11010)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="stage2_container">
