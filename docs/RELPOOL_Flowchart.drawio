        </mxCell>
        <mxCell id="s2_delta" value="&lt;b&gt;Cek Skenario &amp; Inventori*&lt;/b&gt;&lt;br&gt;New Product / Revamp / Reguler Update&lt;br&gt;&lt;i&gt;(*Konfirmasi reuse //EXISTING// host)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontSize=10;dashed=1;dashPattern=5 5;" vertex="1" parent="stage2_container">
          <mxGeometry x="15" y="280" width="210" height="85" as="geometry" />
