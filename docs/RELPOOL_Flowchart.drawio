        <mxCell id="s1_batch" value="&lt;b&gt;Opsi B: Mode Batch CIQ&lt;/b&gt;&lt;br&gt;• Upload File .XLSX / .CSV&lt;br&gt;• Multi-Produk / Aplikasi&lt;br&gt;• Template Sample CSV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=11;" vertex="1" parent="stage1_container">
