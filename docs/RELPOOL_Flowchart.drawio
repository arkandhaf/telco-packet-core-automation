        <!-- YELLOW CONFIRMATION CALLOUT (BAB 5) -->
        <mxCell id="confirm_box" value="&lt;b&gt;🟡 POIN KONFIRMASI TEKNIS TIM CORE (BAB 5):&lt;/b&gt;&lt;br&gt;1. &lt;b&gt;Dual Format Output:&lt;/b&gt; Penyelarasan kapan menggunakan format interaktif &lt;i&gt;Service-V CLI&lt;/i&gt; vs format batch &lt;i&gt;U2000/MAE MML (ADD HOST / ADD FLOWFILTER / ADD RULE)&lt;/i&gt;.&lt;br&gt;2. &lt;b&gt;Bundling Multi-Aplikasi:&lt;/b&gt; Konfirmasi pola kenaikan priority &lt;b&gt;+10 per rule&lt;/b&gt; (27000, 27010, dst.) pada 1 user-profile bersama (contoh: BusinessPack 9 aplikasi).&lt;br&gt;3. &lt;b&gt;Reuse Objek Eksisting:&lt;/b&gt; Pengecekan inventori host/filter yang sudah ada (&lt;i&gt;//EXISTING//&lt;/i&gt;) agar tidak ter-create ulang dan tidak ikut terhapus saat rollback." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontSize=11;align=left;spacingLeft=14;dashed=1;dashPattern=6 6;" vertex="1" parent="1">
