        <!-- TITLE BANNER -->
        <mxCell id="title_box" value="&lt;b style=&quot;font-size:16px;&quot;&gt;ALUR PENGGUNAAN &amp; PEMROSESAN SISTEM — RELPOOL CORE AUTOMATION (v2.2)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#475569;&quot;&gt;Otomasi Provisioning GGSN PCEF (Huawei Service-V CLI) &amp; PCRF UPCC dari Dokumen CIQ&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#0F172A;fontColor=#FFFFFF;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="1080" height="65" as="geometry" />
        </mxCell>

        <!-- STAGE 1: INPUT CIQ -->
        <mxCell id="stage1_container" value="TAHAP 1: INPUT DATA CIQ" style="swimlane;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E3A8A;fontStyle=1;startSize=30;rounded=1;arcSize=8;" vertex="1" parent="1">
